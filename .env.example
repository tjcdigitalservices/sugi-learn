# Supabase — public (browser + server user-scoped clients)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (migrations, seeds, admin scripts; NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — document production URL for Supabase Auth redirect allow-list
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ---------------------------------------------------------------------------
# Production deployment (see docs/PRODUCTION_DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Required on Vercel (Production + Preview for staging):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY  (Production only — not needed for build, used for seeds/ops)
#
# Do NOT commit .env, .env.local, or real credentials.
# Do NOT set DATA_SOURCE=mock in production (not implemented — Supabase required).
#
# Supabase Auth dashboard → URL Configuration:
#   Site URL: your production or staging domain
#   Redirect URLs: https://your-domain.example/** , http://localhost:3000/** (dev only)
#
# Database initialization order (production — not dev test seeds):
#   1. supabase db push  (migrations)
#   2. supabase/seed.sql
#   3. supabase/seed-tikum-kadlum-chapter-1.sql
#   4. supabase/seed-tikum-kadlum-chapter-1-m12.sql (optional)
#   5. supabase/seed-chapters-2-13.sql
#
# NEVER run on production:
#   seed-dev-pre-assessment.sql
#   seed-dev-post-assessment.sql
